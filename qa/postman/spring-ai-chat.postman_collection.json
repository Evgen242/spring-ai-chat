      "name": "A1 — GET /api/health",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('A1: status 200', () => pm.response.to.have.status(200));",
              "pm.test('A1: body = OK', () => pm.expect(pm.response.text().trim()).to.eql('OK'));",
              "pm.test('A1: content-type text/plain', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('text/plain'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
